# =============================================
# GhostOps AI — Environment Variables
# =============================================
# Copy this file to backend/.env for local development, or to .env for
# Docker Compose interpolation. Backend config is validated at boot
# (src/config.ts): a missing/invalid DATABASE_URL refuses to boot, while
# optional keys degrade gracefully and are surfaced in /health and /meta.

# --- Backend ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://ghostops:ghostops_dev_password@localhost:5433/ghostops
LOG_LEVEL=info
LOG_PRETTY=true

# --- Auth ---
SESSION_SECRET=dev-only-session-secret-change-me-0123456789
SESSION_TTL_DAYS=14
COOKIE_SECURE=false
INTEGRATIONS_ENCRYPTION_KEY=dev-only-encryption-key-0123456789abcdef

# --- AI (optional — heuristic fallback engine when absent) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Agent tuning (optional) ---
AGENT_MAX_CONCURRENT_RUNS=3
AGENT_STEP_DELAY_MS=450
AGENT_JOB_MAX_ATTEMPTS=5
AGENT_CYCLE_BUDGET_MS=600000
APPROVAL_TTL_HOURS=24
WORKER_POLL_INTERVAL_MS=1000

# --- Integrations (optional; outbox relays skip when disabled) ---
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=
JIRA_ENABLED=false
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=OPS
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
N8N_ENABLED=false
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_PATH=/webhook/ghostops

# --- Provider intake (optional) ---
PAYMENT_PROVIDER_API_URL=
PAYMENT_PROVIDER_API_KEY=
# Webhook HMAC secrets — empty = provider rejects payloads (secure by default).
PAYMENT_WEBHOOK_SECRET=
BOOKING_WEBHOOK_SECRET=
MONITORING_WEBHOOK_SECRET=
SUPPORT_WEBHOOK_SECRET=

# --- Bootstrap admin (optional; random password logged on first boot if unset) ---
ADMIN_EMAIL=admin@ghostops.local
ADMIN_INITIAL_PASSWORD=

# --- Docker Compose only ---
POSTGRES_USER=ghostops
POSTGRES_PASSWORD=ghostops_dev_password
POSTGRES_DB=ghostops
POSTGRES_PORT=5433
CORS_ORIGIN=http://localhost:5173