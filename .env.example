# =============================================
# GhostOps AI — Environment Variables
# =============================================

# --- Backend ---
PORT=4000
NODE_ENV=development

# --- OpenAI ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# --- Supabase ---
# https://supabase.com/dashboard — create a project, copy these from API settings
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:4000/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- n8n ---
# If you have a local n8n instance running (npx n8n start)
N8N_ENABLED=false
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_PATH=/webhook/ghostops

# --- Slack (mock by default) ---
SLACK_WEBHOOK_URL=
SLACK_ENABLED=false

# --- Jira (mock by default) ---
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=OPS
JIRA_ENABLED=false

# --- Email (mock by default) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_ENABLED=false